#include? "Version.xcconfig"

// Apple Developer Team ID used for code signing (Xcode → Settings… → Accounts → your team).
// Debug builds append it to the bundle id below so every team gets its own
// registrable app id; com.nuvio.app belongs to the upstream developer's team.
TEAM_ID=

PRODUCT_NAME=Nuvio
PRODUCT_BUNDLE_IDENTIFIER=com.nuvio.app.Nuvio$(TEAM_ID)
