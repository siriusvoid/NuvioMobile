#include? "Version.xcconfig"

// Apple Developer Team ID used for code signing. Find it in your Apple Development
// certificate's Organisational Unit (Keychain Access) or developer.apple.com → Membership.
// It is appended to the bundle id below so every team gets its own registrable
// app id; com.nuvio.app / com.nuvio.media belong to the upstream developer's team.
TEAM_ID=

PRODUCT_NAME=Nuvio
PRODUCT_BUNDLE_IDENTIFIER=com.nuvio.app.Nuvio$(TEAM_ID)
